# Copy this file to .env and fill in your own values. .env is gitignored.

# --- LLM providers (used by accountant_brain.py) ---
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- SQL Server output (used by sql_helper.py) ---
# Set to true once you've reviewed sql/schema.sql and filled in DB_* below.
SAVE_TO_SQL=false

# e.g. "localhost\SQLEXPRESS", "MYPC\SQLEXPRESS", or a full Azure SQL hostname
DB_SERVER=
DB_NAME=QbVisaAgentic

# "yes" = Windows Authentication (typical for a local/on-prem SQL Server
#         reached from the same machine or domain). "no" = SQL auth below.
DB_TRUSTED=yes
DB_USER=
DB_PASSWORD=

# Must match a driver actually installed on this machine -
# check with: python -c "import pyodbc; print(pyodbc.drivers())"
DB_DRIVER=ODBC Driver 18 for SQL Server

# Which account these Visa statements belong to (fin.Accounts.AccountName).
# Change this if you're running the pipeline for a different card.
ACCOUNT_NAME=TD Aeroplan Visa Infinite Privilege
